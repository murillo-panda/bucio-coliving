# Configuración pública y reutilizable de la aplicación
VITE_APP_NAME=Bucio Coliving
VITE_MODULE_NAME=Módulo de caja
VITE_ORGANIZATION_NAME=Bucio Coliving
VITE_ORGANIZATION_SLUG=bucio-coliving
VITE_CASH_ACCOUNT_NAME=Caja principal
VITE_CURRENCY=EUR
VITE_LOCALE=es-ES
VITE_TIME_ZONE=Atlantic/Canary
VITE_AUTH_MODE=supabase
VITE_DATA_SOURCE=supabase

# Claves públicas de Supabase (se pueden exponer en el navegador)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor/scripts: nunca uses el prefijo VITE_ ni los publiques en Git
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=TU_SECRET_KEY
ORGANIZATION_NAME=Bucio Coliving
ORGANIZATION_SLUG=bucio-coliving
CASH_ACCOUNT_NAME=Caja principal
CURRENCY=EUR
SITE_URL=https://TU-SITIO.netlify.app

# Instalación inicial
BOOTSTRAP_ADMIN_EMAIL=tu-correo@ejemplo.com
BOOTSTRAP_ADMIN_NAME=Administrador

# Importación única o incremental del histórico
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/ID_PUBLICADO/pub?output=csv
