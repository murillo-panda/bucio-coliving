    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.1",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.4"
  }
